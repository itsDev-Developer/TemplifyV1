# ---- required
BOT_TOKEN=123456:ABC-your-token-from-BotFather
# Your Telegram user id: makes you the owner (admin panel, /stats, /broadcast…). Get it from /id in the bot.
OWNER_ID=
# ---- art sources
# TMDB (movies/TV): https://www.themoviedb.org/settings/api  (v3 key or v4 token). Anime/manga work without it.
TMDB_API_KEY=
# fanart.tv (best logos/backgrounds, enables the 3 Fanart templates): https://fanart.tv/get-an-api-key/
FANART_API_KEY=
# ---- channels (optional; can also be set later inside the bot: /admin). The bot must be ADMIN there.
LOG_CHANNEL_ID=
# Set this one in the environment too on Render: it is used to restore the database after a redeploy.
STORAGE_CHANNEL_ID=
# ---- tuning (all optional)
# RENDER_SCALE=1.5          # default quality; users can choose 720p/1080p/1440p in /settings
# RENDER_CONCURRENCY=2      # simultaneous renders (use 1 on small hosts)
# WORKERS=16                # update worker threads
# SUDO_IDS=111,222          # extra admins
# BUTTON_STYLES=1           # coloured buttons (auto-disables if Telegram rejects them)
# DATA_DIR=data             # SQLite lives in DATA_DIR/bot.db (mount a Render disk here to persist it)
# PORT / RENDER_EXTERNAL_URL are set by Render. WEBHOOK_URL forces webhook mode, MODE=polling forces polling.

# --- API for other bots (keys are created in the bot with /apikey; limits editable in /admin) ---
# Nothing to set here. Endpoint: https://<your-app>/api/v1  (see docs/API.md)
# Output: LOG_FORMAT=json prints one JSON object per log line (for Render/Datadog/etc.)
LOG_FORMAT=text
